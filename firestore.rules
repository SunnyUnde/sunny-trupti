rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== SHARED HELPERS =====
    function isSignedIn() {
      return request.auth != null;
    }
    function member() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }
    function isMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function isOwner() {
      return isMember() && member().role == 'owner';
    }
    function isEditor() {
      return isMember() && member().role in ['owner', 'editor'];
    }
    function sideOf() {
      return member().side;
    }

    // ===== PLANNER =====
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // members/{uid}: owner docs come only from the console. An owner approves
    // (creates), changes role, or removes readers and editors of their own side.
    match /members/{uid} {
      function memberKeys() {
        return ['role', 'side', 'email', 'name', 'photoURL', 'approvedAt', 'approvedBy'];
      }
      function requestDoc() {
        return /databases/$(database)/documents/access_requests/$(uid);
      }
      // reader with no side, or editor on the caller's (owner's) side.
      function grantable(d) {
        return (d.role == 'reader' && d.side == null)
          || (d.role == 'editor' && d.side in ['groom', 'bride'] && d.side == sideOf());
      }
      function validApproval() {
        let d = request.resource.data;
        return exists(requestDoc())
          && d.keys().hasOnly(memberKeys())
          && d.keys().hasAll(memberKeys())
          && grantable(d)
          && d.email == get(requestDoc()).data.email
          && d.name == get(requestDoc()).data.name
          && (d.photoURL == null || d.photoURL is string)
          && d.approvedAt is timestamp
          && d.approvedBy == request.auth.uid;
      }
      // Promotion reader -> editor (onto the caller's side) by any owner;
      // editor of side S -> reader, or editor kept, only by the owner of side S.
      function validChange() {
        let d = request.resource.data;
        let o = resource.data;
        let touched = d.diff(o).affectedKeys();
        return touched.hasOnly(['role', 'side', 'approvedAt', 'approvedBy'])
          && (o.role == 'reader' || (o.role == 'editor' && o.side == sideOf()))
          && grantable(d)
          && (!touched.hasAny(['approvedAt']) || d.approvedAt is timestamp)
          && (!touched.hasAny(['approvedBy']) || d.approvedBy == request.auth.uid);
      }
      function removable() {
        return resource.data.role == 'reader'
          || (resource.data.role == 'editor' && resource.data.side == sideOf());
      }

      allow get: if isSelf(uid) || isOwner();
      allow list: if isOwner();
      allow create: if isOwner() && validApproval();
      allow update: if isOwner() && validChange();
      allow delete: if isOwner() && removable();
    }

    // access_requests/{uid}: a non-member asks for access as themselves.
    match /access_requests/{uid} {
      function validRequest() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'name', 'photoURL', 'requestedAt'])
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && d.email == request.auth.token.email
          && d.name == request.auth.token.get('name', '')
          && (d.get('photoURL', null) == null || d.photoURL is string)
          && d.requestedAt is timestamp;
      }

      allow get: if isSelf(uid) || isOwner();
      allow list: if isOwner();
      allow create: if isSelf(uid)
        && !exists(/databases/$(database)/documents/members/$(uid))
        && validRequest();
      allow delete: if isSelf(uid) || isOwner();
    }

    // prefs/{uid}: a member's own view mode.
    match /prefs/{uid} {
      allow read, delete: if isSelf(uid) && isMember();
      allow create, update: if isSelf(uid) && isMember()
        && request.resource.data.keys().hasOnly(['mode'])
        && request.resource.data.mode in ['simple', 'full'];
    }

    // Visibilities the caller may see and write. Owners are planners too.
    function visibleFor() {
      return member().role == 'reader' ? ['everyone'] : ['everyone', 'planners', sideOf()];
    }
    function canSee(d) {
      return isMember() && d.visibility in visibleFor();
    }
    function canPlan(d) {
      return isEditor()
        && d.visibility in ['everyone', 'planners', 'groom', 'bride']
        && d.visibility in visibleFor();
    }
    function statuses() {
      return ['todo', 'progress', 'done'];
    }

    // tasks/{taskId}: read by visibility; writes by planners, within their set
    // before and after the change.
    match /tasks/{taskId} {
      function validTask(d) {
        return d.status in statuses()
          && d.due is string
          && d.labels is list;
      }
      function canPlanParent() {
        return canPlan(get(/databases/$(database)/documents/tasks/$(taskId)).data);
      }

      allow read: if canSee(resource.data);
      allow create: if canPlan(request.resource.data)
        && validTask(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if canPlan(resource.data)
        && canPlan(request.resource.data)
        && validTask(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if canPlan(resource.data);

      // Never readable by readers. Planners delete subcollection docs before
      // the task itself, so deletes rely on the parent still existing.
      match /private/notes {
        allow read, delete: if canPlanParent();
        allow create, update: if canPlanParent()
          && request.resource.data.keys().hasOnly(['text'])
          && request.resource.data.text is string;
      }

      match /comments/{commentId} {
        allow read, delete: if canPlanParent();
        allow create: if canPlanParent()
          && request.resource.data.keys().hasOnly(['text', 'by', 'at'])
          && request.resource.data.text is string
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at is timestamp;
        allow update: if canPlanParent()
          && resource.data.by == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string;
      }

      // Never rewritten; deletable only so a task delete can cascade.
      match /history/{historyId} {
        allow read, delete: if canPlanParent();
        allow create: if canPlanParent()
          && request.resource.data.keys().hasOnly(['from', 'to', 'by', 'at'])
          && request.resource.data.from in statuses()
          && request.resource.data.to in statuses()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at is timestamp;
      }
    }

    match /events/{eventId} {
      allow read: if canSee(resource.data);
      allow create: if canPlan(request.resource.data);
      allow update: if canPlan(resource.data) && canPlan(request.resource.data);
      allow delete: if canPlan(resource.data);
    }

    // A label linked to an event must not reveal a hidden one to readers.
    match /labels/{labelId} {
      function validLabel(d) {
        return d.group in ['day', 'category']
          && (d.get('eventId', null) == null
            || get(/databases/$(database)/documents/events/$(d.eventId)).data.visibility == 'everyone');
      }

      allow read: if isMember();
      allow create, update: if isEditor() && validLabel(request.resource.data);
      allow delete: if isEditor();
    }

    match /vendors/{vendorId} {
      allow read, delete: if isEditor();
      allow create, update: if isEditor()
        && request.resource.data.status in ['to_find', 'shortlisted', 'booked', 'paid'];
    }

    match /settings/budget {
      allow read, write: if isEditor();
    }

    // ===== REGISTRY =====
    match /registry/{rest=**} { allow read, write: if false; }
    // ===== END REGISTRY =====
  }
}
